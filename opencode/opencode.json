{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "git *": "allow",
      "git commit *": "allow",
      "git push *": "deny",
      "grep *": "allow"
    },
    "read": {
      "*": "allow",
      "*.dev.vars": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "formatter": {
    "eslint": {
      "command": [
        "npx",
        "eslint",
        "--fix"
      ]
    }
  },
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "YOUR_STITCH_MCP_URL",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  }
}